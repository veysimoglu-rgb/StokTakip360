<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Tests must never reach the live MMC license service. Blank values make the license gate
             "not configured" (fail-open), so ordinary feature tests are never blocked by it. The
             license tests set their own config (https://mmc.test) and use Http::fake. force="true"
             wins over a real .env; the matching <server> entries are needed too because Laravel reads
             $_SERVER before $_ENV, so variables exported in the shell or CI would otherwise still win. -->
        <env name="MMC_BASE_URL" value="" force="true"/>
        <env name="MMC_SECRET" value="" force="true"/>
        <env name="MMC_LICENSE_KEY" value="" force="true"/>
        <env name="MMC_API_KEY" value="" force="true"/>
        <server name="MMC_BASE_URL" value="" force="true"/>
        <server name="MMC_SECRET" value="" force="true"/>
        <server name="MMC_LICENSE_KEY" value="" force="true"/>
        <server name="MMC_API_KEY" value="" force="true"/>
        <!-- The header rate widget must never call the real TCMB service from tests: the feature is
             switched off here, and its own tests turn it on together with Http::fake(). -->
        <env name="TCMB_RATES_ENABLED" value="false" force="true"/>
        <server name="TCMB_RATES_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
